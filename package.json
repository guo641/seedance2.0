{
  "name": "seedance-reverse",
  "version": "1.0.9",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "next lint",
    "desktop:prepare": "next build && node scripts/build-desktop.mjs",
    "desktop:dev": "npm run desktop:prepare && electron .",
    "dist": "npm run desktop:prepare && electron-builder --win --publish never",
    "dist:publish": "npm run desktop:prepare && electron-builder --win --publish always",
    "hotbundle": "node scripts/pack-hotbundle.mjs"
  },
  "dependencies": {
    "next": "15.1.6",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "better-sqlite3": "11.8.1",
    "jose": "5.9.6",
    "bcryptjs": "2.4.3",
    "openai": "4.79.1",
    "ffmpeg-static": "5.2.0",
    "ffprobe-static": "3.1.0",
    "fluent-ffmpeg": "2.1.3",
    "qrcode": "1.5.4",
    "nanoid": "5.0.9",
    "adm-zip": "0.5.16",
    "electron-updater": "6.3.9"
  },
  "build": {
    "appId": "com.tianchen.seedance.reverse",
    "productName": "Seedance2.0反推",
    "asar": true,
    "asarUnpack": [
      "**/*.node"
    ],
    "afterPack": "scripts/afterPack.js",
    "files": [
      "electron/**/*"
    ],
    "extraResources": [
      {
        "from": ".next/standalone",
        "to": "app"
      }
    ],
    "npmRebuild": true,
    "directories": {
      "output": "dist-desktop"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "guo641",
        "repo": "seedance2.0",
        "releaseType": "release"
      }
    ]
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8",
    "@electron/rebuild": "^3.6.0",
    "@types/node": "22.10.7",
    "@types/react": "19.0.7",
    "@types/react-dom": "19.0.3",
    "@types/better-sqlite3": "7.6.12",
    "@types/bcryptjs": "2.4.6",
    "@types/fluent-ffmpeg": "2.1.27",
    "@types/qrcode": "1.5.5",
    "typescript": "5.7.3",
    "tailwindcss": "3.4.17",
    "postcss": "8.5.1",
    "autoprefixer": "10.4.20"
  }
}