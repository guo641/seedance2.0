# ─── yunwu.ai 中转站 (OpenAI 兼容) ───
# 你的 yunwu key
YUNWU_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
YUNWU_BASE_URL=https://yunwu.ai/v1

# 音频转写(字幕)。格式 model:fmt,逗号分隔,按序降级。
# whisper-1:srt 带时间戳(利于说话人对齐),其它模型用 text。
ASR_MODELS=whisper-1:srt,gpt-4o-transcribe:text,gpt-4o-mini-transcribe:text

# 抽帧:约每 FRAME_EVERY_SEC 秒 1 帧,夹在 [MIN_FRAMES, MAX_FRAMES]
FRAME_EVERY_SEC=2.5
MIN_FRAMES=12
MAX_FRAMES=32

# ─── 鉴权 ───
# JWT 签名密钥,自行改成随机长串
AUTH_SECRET=change-me-to-a-long-random-string

# 超级管理员账号(用于 /superadmin 后台)
SUPERADMIN_USER=admin
SUPERADMIN_PASS=admin888

# ─── 抖音/多平台 解析服务(shuiying.nxux.cn 背后的接口) ───
DOUYIN_API_BASE=https://api.bugpk.com

# ─── 业务参数 ───
# 新注册用户默认赠送次数
DEFAULT_QUOTA=0
# 每段最大时长(秒)—— Seedance 2.0 分镜铁律
SEGMENT_SECONDS=12
# 从视频中抽取的关键帧数量上限(喂给视觉模型)
MAX_FRAMES=16
